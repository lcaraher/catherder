# PostgreSQL connection string read by Prisma and the app; this default matches the docker-compose db service published on localhost:5432 (compose sets its own copy for the app container, pointing at the "db" host).
DATABASE_URL=postgresql://catherder:catherder@localhost:5432/catherder

# OIDC issuer expected in ID tokens' `iss` claim (for local dev, the app's own built-in dev issuer).
AUTH_ISSUER=http://localhost:3001/api/dev-auth

# Audience expected in ID tokens' `aud` claim.
AUTH_AUDIENCE=catherder-dev

# JWKS endpoint of the issuer, used to verify ID token signatures.
AUTH_JWKS_URL=http://localhost:3001/api/dev-auth/jwks

# Secret used to sign the httpOnly session cookie; generate 32+ random bytes per environment (e.g. `openssl rand -hex 32`).
AUTH_SESSION_SECRET=

# "true" enables the built-in dev token issuer and /dev-login; refused with a startup error when NODE_ENV=production.
AUTH_DEV_ISSUER=false
