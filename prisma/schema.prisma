generator client {
  provider   = "prisma-client-js"
  // Engine-free client: queries run through the pg driver adapter, no Rust binary.
  engineType = "client"
}

// Plain PostgreSQL only — no vendor-specific extensions or proprietary SQL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventMode {
  MULTI_GROUP
  SINGLE_ACTIVITY
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EventParticipantRole {
  ORGANIZER
  PLAYER
}

enum ResponseStatus {
  INVITED
  SUBMITTED
}

enum AvailabilityStatus {
  AVAILABLE
  TENTATIVE
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TEXT
  RANKING
}

enum ClockFormat {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

model User {
  id          String   @id @default(cuid())
  displayName String
  email       String   @unique
  // IANA time-zone name (e.g. "America/New_York"); availability times are
  // local wall-clock in this zone, never UTC.
  timeZone         String
  // How this user reads times everywhere: 7:30 PM vs 19:30. Display only —
  // storage stays slot-based local wall-clock regardless.
  clockFormat ClockFormat @default(TWELVE_HOUR)
  // The device zone the user chose to ignore; cleared whenever the profile
  // zone changes.
  dismissedDeviceZone String?
  // Free-text note shown alongside standing availability. Sensitive: never log.
  availabilityNote String?
  // Site-wide admin, may manage any event; never shown to anyone else.
  siteAdmin        Boolean  @default(false)
  createdAt        DateTime @default(now())

  identities           ExternalIdentity[]
  organizedEvents      Event[]                @relation("EventOrganizer")
  eventParticipations  EventParticipant[]
  standingAvailability StandingAvailability[]
  eventAvailability    EventAvailability[]
  answers              Answer[]
  auditEvents          AuditEvent[]
  createdInvites       EventInvite[]
}

model ExternalIdentity {
  id        String   @id @default(cuid())
  userId    String
  issuer    String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([issuer, subject])
  @@index([userId])
}

model Event {
  id              String    @id @default(cuid())
  name            String
  mode            EventMode
  organizerUserId String
  // Whether the organizer also responds as a participant. Off: only their
  // availability is used and they are never asked to respond.
  organizerParticipates Boolean @default(false)
  // Target session length in half-hour slots (e.g. 6 = 3 hours).
  requiredSlots Int
  minGroupSize  Int?
  maxGroupSize  Int?
  status        EventStatus
  // Markdown shown to participants; null when blank. At most 10,000 characters.
  description String?
  // When set, responses/overlap/results are visible to participants too.
  // Null = visible to the event's Organizer only.
  resultsRevealedAt DateTime?
  // When set, the event is hidden from lists and never editable by anyone.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  organizerUser User                @relation("EventOrganizer", fields: [organizerUserId], references: [id])
  participants  EventParticipant[]
  availability  EventAvailability[]
  questions     Question[]
  answers       Answer[]
  invite        EventInvite?

  @@index([organizerUserId])
}

// One multi-use join code per event; regenerating replaces it in place.
model EventInvite {
  id      String @id @default(cuid())
  eventId String @unique
  // Canonical form: 10 upper-case Crockford base32 characters, no hyphen.
  code            String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  // Set each time the code is replaced.
  regeneratedAt DateTime?

  event     Event @relation(fields: [eventId], references: [id])
  createdBy User  @relation(fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
}

model EventParticipant {
  eventId        String
  userId         String
  role           EventParticipantRole
  responseStatus ResponseStatus
  // Free-text note for this event. Sensitive: never log.
  note           String?
  // Organizer-granted permission to keep editing while the event is CLOSED.
  // Null = no unlock granted.
  editUnlockedAt DateTime?

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
  @@index([userId])
}

model StandingAvailability {
  id      String @id @default(cuid())
  userId  String
  version Int
  // 0 = Monday … 6 = Sunday
  weekday Int
  // Local wall-clock times in the user's timeZone, never UTC.
  startLocal DateTime           @db.Time()
  endLocal   DateTime           @db.Time()
  status     AvailabilityStatus @default(AVAILABLE)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EventAvailability {
  id      String @id @default(cuid())
  eventId String
  userId  String
  // 0 = Monday … 6 = Sunday
  weekday Int
  // Local wall-clock times in the user's timeZone, never UTC.
  startLocal                DateTime           @db.Time()
  endLocal                  DateTime           @db.Time()
  status                    AvailabilityStatus @default(AVAILABLE)
  copiedFromStandingVersion Int

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
}

model Question {
  id           String       @id @default(cuid())
  eventId      String
  type         QuestionType
  prompt       String
  version      Int
  displayOrder Int
  // Per-question participant visibility: even once event results are shared,
  // a question's answers stay manager-only until this is true.
  answersRevealed Boolean @default(false)
  // Participants cannot submit a response without answering this question.
  // Enforced at submit time only; existing answers are never re-validated.
  required Boolean @default(false)
  // Choice questions only: offers a free-text "Other" alongside the options.
  allowOther Boolean @default(false)

  event   Event            @relation(fields: [eventId], references: [id])
  options QuestionOption[]
  answers Answer[]

  @@index([eventId])
}

model QuestionOption {
  id           String @id @default(cuid())
  questionId   String
  label        String
  displayOrder Int

  question Question       @relation(fields: [questionId], references: [id])
  choices  AnswerChoice[]

  @@index([questionId])
}

model Answer {
  id              String   @id @default(cuid())
  questionId      String
  questionVersion Int
  eventId         String
  userId          String
  // Free-text "Other" on a choice question. Sensitive: never log.
  otherText String?
  updatedAt DateTime @updatedAt

  question Question       @relation(fields: [questionId], references: [id])
  event    Event          @relation(fields: [eventId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  choices  AnswerChoice[]
  text     AnswerText?

  @@unique([questionId, userId])
  @@index([eventId])
  @@index([userId])
}

model AnswerChoice {
  answerId String
  optionId String
  // Set for RANKING questions only.
  rank Int?

  answer Answer         @relation(fields: [answerId], references: [id])
  option QuestionOption @relation(fields: [optionId], references: [id])

  @@id([answerId, optionId])
  @@index([optionId])
}

model AnswerText {
  answerId String @id
  text     String

  answer Answer @relation(fields: [answerId], references: [id])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  entity      String
  entityId    String
  action      String
  // Snapshot of what a destructive action removed, for hand restoration.
  // May hold participants' free text — same protection as answers, never logged.
  detail Json?
  at     DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
}
